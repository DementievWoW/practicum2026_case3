// ОБЗОР: 6 компонентов + поток между ними (сверху→вниз). Детали — в target_*.png.
// Рендер: dot -Tpng docs/target_overview.dot -o docs/target_overview.png
digraph Overview {
    rankdir=TB;
    fontname="Helvetica";
    bgcolor="white";
    nodesep=0.5; ranksep=0.85;
    node [shape=plaintext, fontname="Helvetica"];
    edge [fontname="Helvetica-Bold", fontsize=11, color="#37474F", penwidth=1.7];

    task [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#ECEFF1">
        <tr><td><b>task (NL-запрос)</b></td></tr>
        <tr><td align="left">«покажи договоры с просрочкой»</td></tr></table>>];

    schema [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#E3F2FD">
        <tr><td bgcolor="#1E88E5"><font color="white"><b>① Schema layer · Участник 1</b></font></td></tr>
        <tr><td align="left">DDL-парсер → каталог(60) → карточки → эмбеддинги → FAISS</td></tr>
        <tr><td align="left">статус: 🟢2 готово · 🟧1 заглушка · ⬜2 не написано</td></tr>
        <tr><td><i>детали → target_schema.png</i></td></tr></table>>];

    gen [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFF3E0">
        <tr><td bgcolor="#FB8C00"><font color="white"><b>② Генератор SQL · Участник 3</b></font></td></tr>
        <tr><td align="left">эмбеддинг вопроса → schema linking → FK → промпт → LLM (Qwen2.5-Coder-32B-Instruct)</td></tr>
        <tr><td align="left">статус: 🟢2 готово · 🟧1 МОК LLM · ⬜3 не написано</td></tr>
        <tr><td><i>детали → target_gen.png</i></td></tr></table>>];

    judge [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#E8F5E9">
        <tr><td bgcolor="#2E7D32"><font color="white"><b>③ Судья (аудитор) · Участник 2</b></font></td></tr>
        <tr><td align="left">P1: pglast → R001-R013 → sensitive → EXPLAIN</td></tr>
        <tr><td align="left">P1.5: CodeBERT · P2: RAG + LLM-судья · агрегатор risk=MAX</td></tr>
        <tr><td align="left">статус: 🟢1 готово · 🟧2 заглушки + 1 МОК · ⬜4 не написано</td></tr>
        <tr><td><i>детали → target_judge.png</i></td></tr></table>>];

    decide [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFF9C4">
        <tr><td bgcolor="#FBC02D"><b>④ Оркестратор / решение · Участник 4</b></td></tr>
        <tr><td align="left">LangGraph-цикл · approved? risk &lt; 4.0 · до 5 итераций</td></tr>
        <tr><td align="left">статус: 🟢 цикл+решение готовы · ⬜ persist/инфра</td></tr>
        <tr><td><i>детали → target_core.png</i></td></tr></table>>];

    refl [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#F3E5F5">
        <tr><td bgcolor="#8E24AA"><font color="white"><b>Reflector · Участник 3</b></font></td></tr>
        <tr><td align="left">findings судьи → «урок» в промпт</td></tr>
        <tr><td align="left">статус: 🟢 dedup · 🟧 модель-заглушка</td></tr></table>>];

    result [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#C8E6C9">
        <tr><td><b>⑤ SystemResult</b></td></tr>
        <tr><td align="left">final_sql + audit_log + risk_trajectory</td></tr>
        <tr><td bgcolor="#A5D6A7">🟢 готово · contracts.py</td></tr></table>>];

    infra [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FAFAFA">
        <tr><td bgcolor="#607D8B"><font color="white"><b>Инфраструктура · Участник 4</b></font></td></tr>
        <tr><td align="left">Postgres sandbox · Vector store · Langfuse</td></tr>
        <tr><td align="left">статус: ⬜ не написано</td></tr></table>>];

    // ── главный поток сверху→вниз ──
    task   -> gen    [label="запрос"];
    schema -> gen    [label="индекс + DDL", style=dotted, color="#1E88E5", fontcolor="#1E88E5"];
    gen    -> judge  [label="SQL-кандидат"];
    judge  -> decide [label="AuditResult"];
    decide -> result [label="одобрено ✓", color="#43A047", fontcolor="#43A047"];

    // ── петля итерации (вбок, не одобрено) ──
    decide -> refl [label="не одобрено ✗", color="#E53935", fontcolor="#E53935", constraint=false];
    refl   -> gen  [label="урок (loop, до 5)", style="dashed", color="#8E24AA", fontcolor="#8E24AA", constraint=false];

    // ── инфра сбоку ──
    decide -> infra [style=dotted, color="#BDBDBD", label="трейс/чекпойнт", constraint=false];

    // выравнивание: schema слева от gen, refl справа от gen
    { rank=same; schema; gen; refl; }
    { rank=same; decide; infra; }
}
