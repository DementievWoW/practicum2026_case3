// ЦЕЛЕВАЯ архитектура: ожидаемый функционал (@brief + ЗАЧЕМ) + СТАТУС реализации.
// В каждом узле: название · @brief · ЗАЧЕМ · СТАТУС (готово/мок/заглушка/план + файл/роль).
// Цвет узла: фиолетовый=парсер, голубой=алгоритм, оранжевый=модель, серый=данные.
// Рендер: dot -Tpng docs/target_components.dot -o docs/target_components.png
digraph Target {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    bgcolor="white";
    nodesep=0.35; ranksep=0.7;
    node [shape=plaintext, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    task   [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#ECEFF1">
        <tr><td><b>task (NL)</b></td></tr>
        <tr><td align="left">«покажи договоры с просрочкой»</td></tr></table>>];
    result [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#C8E6C9">
        <tr><td><b>SystemResult</b></td></tr>
        <tr><td align="left">final_sql + audit_log + risk_trajectory</td></tr>
        <tr><td bgcolor="#A5D6A7">🟢 готово · contracts.py</td></tr></table>>];

    // ═══════════ КОМПОНЕНТ: Schema layer ═══════════
    subgraph cluster_schema {
        label="КОМПОНЕНТ: Schema layer  —  сырой DDL → поисковый индекс";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#1E88E5"; fillcolor="#E3F2FD";

        ddl_parser [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#CE93D8">
            <tr><td><b>DDL-парсер (regex/pglast)</b></td></tr>
            <tr><td align="left">@brief data_model.sql → структура</td></tr>
            <tr><td align="left">ЗАЧЕМ: 657 KB SQL → таблицы, колонки, FK</td></tr>
            <tr><td bgcolor="#FFCC80">🟧 ЗАГЛУШКА · parser.py · Участник 1</td></tr></table>>];
        catalog [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>schema_catalog (60 таблиц)</b></td></tr>
            <tr><td align="left">@brief каталог: credit_contract, acc_number...</td></tr>
            <tr><td align="left">ЗАЧЕМ: единый источник схемы</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · models.py (структура)</td></tr></table>>];
        card [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>карточки таблиц — to_card()</b></td></tr>
            <tr><td align="left">@brief таблица → текст «имя+коммент+колонки»</td></tr>
            <tr><td align="left">ЗАЧЕМ: эмбеддить осмысленный текст</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · models.py</td></tr></table>>];
        sch_embed [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
            <tr><td><b>эмбеддинг карточек (multilingual-e5)</b></td></tr>
            <tr><td align="left">@brief карточка → вектор (1024)</td></tr>
            <tr><td align="left">ЗАЧЕМ: поиск таблиц по смыслу</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 1</td></tr></table>>];
        faiss_idx [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>FAISS index</b></td></tr>
            <tr><td align="left">@brief индекс векторов 60 таблиц</td></tr>
            <tr><td align="left">ЗАЧЕМ: мгновенный поиск top-K</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 1</td></tr></table>>];

        ddl_parser -> catalog -> card -> sch_embed -> faiss_idx;
    }

    // ═══════════ КОМПОНЕНТ: Генератор ═══════════
    subgraph cluster_gen {
        label="КОМПОНЕНТ: Генератор SQL  —  NL → SQL по релевантной схеме · Участник 3 (LLM)";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#FB8C00"; fillcolor="#FFF3E0";

        g_qembed [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
            <tr><td><b>эмбеддинг вопроса (e5)</b></td></tr>
            <tr><td align="left">@brief NL-вопрос → вектор</td></tr>
            <tr><td align="left">ЗАЧЕМ: сравнить с карточками таблиц</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 3</td></tr></table>>];
        g_search [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>schema linking — FAISS top-15</b></td></tr>
            <tr><td align="left">@brief выбрать релевантные таблицы из 60</td></tr>
            <tr><td align="left">ЗАЧЕМ: все 60 в промпт не влезут</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 3</td></tr></table>>];
        g_fk [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>FK-замыкание</b></td></tr>
            <tr><td align="left">@brief добавить таблицы по FK</td></tr>
            <tr><td align="left">ЗАЧЕМ: JOIN не сломается</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · models.fk_closure()</td></tr></table>>];
        g_fewshot [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>few-shot retrieval</b></td></tr>
            <tr><td align="left">@brief похожие примеры NL→SQL</td></tr>
            <tr><td align="left">ЗАЧЕМ: модель пишет в нужном стиле</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 3</td></tr></table>>];
        g_prompt [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>сборка промпта</b></td></tr>
            <tr><td align="left">@brief DDL + few-shot + reflection</td></tr>
            <tr><td align="left">ЗАЧЕМ: дать LLM весь контекст</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 каркас готов · generator.py</td></tr></table>>];
        g_llm [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
            <tr><td><b>LLM генератор · Qwen2.5-Coder-32B</b></td></tr>
            <tr><td align="left">@brief промпт → SQL</td></tr>
            <tr><td align="left">ЗАЧЕМ: ядро — понять NL и написать SQL</td></tr>
            <tr><td bgcolor="#FF8A65"><b>🟧 МОК · mock.py → Участник 3</b></td></tr></table>>];

        g_qembed -> g_search -> g_fk -> g_prompt -> g_llm;
        g_fewshot -> g_prompt;
    }

    // ═══════════ КОМПОНЕНТ: Судья ═══════════
    subgraph cluster_aud {
        label="КОМПОНЕНТ: Судья (аудитор)  —  алгоритмы + модели · Участник 2";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#2E7D32"; fillcolor="#E8F5E9";

        subgraph cluster_p1 {
            label="Phase 1 — детерминированно (алгоритмы)";
            labeljust="l"; fontsize=11; style="rounded,filled"; color="#43A047"; fillcolor="#F1F8E9";
            sql_parser [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#CE93D8">
                <tr><td><b>SQL-парсер pglast</b></td></tr>
                <tr><td align="left">@brief sql → AST</td></tr>
                <tr><td align="left">ЗАЧЕМ: точнее регекса, устойчив к обфускации</td></tr>
                <tr><td bgcolor="#ECEFF1">⬜ pglast не написан (пока regex) → Участник 2</td></tr></table>>];
            rules [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
                <tr><td><b>правила R001-R013</b></td></tr>
                <tr><td align="left">@brief SELECT*, DML без WHERE, UNION...</td></tr>
                <tr><td align="left">ЗАЧЕМ: 9 классов уязвимостей</td></tr>
                <tr><td bgcolor="#FFCC80">🟧 ЗАГЛУШКИ (2 раб.+7 TODO) · auditor.py · Участник 2</td></tr></table>>];
            sensitive [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
                <tr><td><b>детектор sensitive R009</b></td></tr>
                <tr><td align="left">@brief regex имён + Luhn/СНИЛС</td></tr>
                <tr><td align="left">ЗАЧЕМ: паспорта/карты/пароли (152-ФЗ)</td></tr>
                <tr><td bgcolor="#FFCC80">🟧 ЗАГЛУШКА · sensitive.py · Участник 2</td></tr></table>>];
            explain [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
                <tr><td><b>EXPLAIN-анализ</b></td></tr>
                <tr><td align="left">@brief план: cost, seq scan, cartesian</td></tr>
                <tr><td align="left">ЗАЧЕМ: тяжесть без исполнения данных</td></tr>
                <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 2</td></tr></table>>];
            sql_parser -> rules;
        }
        subgraph cluster_p15 {
            label="Phase 1.5 — ML-классификатор";
            labeljust="l"; fontsize=11; style="rounded,filled"; color="#43A047"; fillcolor="#F1F8E9";
            codebert [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
                <tr><td><b>CodeBERT classifier (SQLQueryShield)</b></td></tr>
                <tr><td align="left">@brief sql → P(malicious/safe)</td></tr>
                <tr><td align="left">ЗАЧЕМ: ловит что правила пропускают</td></tr>
                <tr><td bgcolor="#ECEFF1">⬜ не написано (бонус) → Участник 2</td></tr></table>>];
        }
        subgraph cluster_p2 {
            label="Phase 2 — LLM-триаж + RAG";
            labeljust="l"; fontsize=11; style="rounded,filled"; color="#43A047"; fillcolor="#F1F8E9";
            rag [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
                <tr><td><b>RAG retrieval (BM25 + dense)</b></td></tr>
                <tr><td align="left">@brief поиск CWE / CAPEC / OWASP</td></tr>
                <tr><td align="left">ЗАЧЕМ: знания + верифицируемые ссылки</td></tr>
                <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 2</td></tr></table>>];
            judge_llm [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
                <tr><td><b>LLM судья · Qwen2.5-7B</b></td></tr>
                <tr><td align="left">@brief триаж findings + объяснение</td></tr>
                <tr><td align="left">ЗАЧЕМ: отсеять FP, дать рекомендацию</td></tr>
                <tr><td bgcolor="#FF8A65"><b>🟧 МОК · mock.py · модель: Участник 3</b></td></tr></table>>];
            rag -> judge_llm;
        }
        aggregate [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>агрегатор вердикта</b></td></tr>
            <tr><td align="left">@brief risk = MAX; approved = risk &lt; 4.0</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · auditor.py (HybridAuditor)</td></tr></table>>];

        rules -> aggregate; sensitive -> aggregate; explain -> aggregate;
        codebert -> aggregate; judge_llm -> aggregate;
    }

    // ═══════════ КОМПОНЕНТ: Reflector ═══════════
    subgraph cluster_refl {
        label="КОМПОНЕНТ: Reflector  —  in-context loop · Участник 3";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#2E7D32"; fillcolor="#E8F5E9";
        refl_model [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFB74D">
            <tr><td><b>reflector · Qwen-7B / FLAN-T5</b></td></tr>
            <tr><td align="left">@brief findings судьи → «урок»</td></tr>
            <tr><td align="left">ЗАЧЕМ: генератор не повторяет ошибку</td></tr>
            <tr><td bgcolor="#FFCC80">🟧 ЗАГЛУШКА (детермин.) · reflector.py · Участник 3</td></tr></table>>];
        refl_dedup [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>дедуп + окно 5 уроков</b></td></tr>
            <tr><td align="left">@brief память последних уроков</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · reflector.py</td></tr></table>>];
        refl_model -> refl_dedup;
    }

    // ═══════════ КОМПОНЕНТ: Оркестратор ═══════════
    subgraph cluster_orch {
        label="КОМПОНЕНТ: Оркестратор — ядро системы · Участник 4";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#1E88E5"; fillcolor="#E3F2FD";
        cycle [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#90CAF9">
            <tr><td><b>LangGraph цикл</b></td></tr>
            <tr><td align="left">@brief gen → audit → reflect, до 5 итер.</td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово (Python-цикл) · pipeline.py</td></tr></table>>];
        decide [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#FFF9C4">
            <tr><td><b>approved? (risk &lt; 4.0)</b></td></tr>
            <tr><td bgcolor="#A5D6A7">🟢 готово · pipeline.py</td></tr></table>>];
        persist [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>PostgresSaver</b></td></tr>
            <tr><td align="left">@brief checkpoints, time-travel</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 4</td></tr></table>>];
        cycle -> decide;
    }

    // ═══════════ КОМПОНЕНТ: Инфраструктура ═══════════
    subgraph cluster_infra {
        label="КОМПОНЕНТ: Инфраструктура / хранилища";
        labeljust="l"; fontsize=13; fontname="Helvetica-Bold";
        style="rounded,filled"; color="#607D8B"; fillcolor="#FAFAFA";
        sandbox [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>Postgres sandbox</b></td></tr>
            <tr><td align="left">@brief EXPLAIN, faker, state</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано (есть overlay.sql) → Участник 4</td></tr></table>>];
        vstore [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>Vector store</b></td></tr>
            <tr><td align="left">@brief RAG + эмбеддинги схемы</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 4</td></tr></table>>];
        langfuse [label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#B0BEC5">
            <tr><td><b>Langfuse</b></td></tr>
            <tr><td align="left">@brief трейсы, scoring, A/B</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано → Участник 4</td></tr></table>>];
    }

    // ═══════════ ПОТОК между компонентами ═══════════
    // (А) невидимый «хребет» задаёт вертикальный порядок компонентов сверху→вниз
    task      -> ddl_parser [style=invis, weight=30];
    faiss_idx -> g_qembed   [style=invis, weight=30];

    // (Б) ГЛАВНЫЙ ПОТОК сверху→вниз (формирует ранги: gen → судья → решение → выход)
    g_llm -> sql_parser [lhead=cluster_aud, label="2. sql_candidate", weight=30, color="#1E88E5", fontcolor="#1E88E5"];
    aggregate -> decide [ltail=cluster_aud, lhead=cluster_orch, label="3. AuditResult", weight=30, color="#1E88E5", fontcolor="#1E88E5"];
    decide -> result [label="одобрено ✓", weight=30, color="#43A047", fontcolor="#43A047"];

    // (В) оркестратор управляет генерацией (вбок, ранги не двигает)
    task  -> cycle    [label="запрос", constraint=false];
    cycle -> g_prompt [lhead=cluster_gen, label="1. генерация", constraint=false, color="#1E88E5", fontcolor="#1E88E5"];

    // (Г) боковые связи-поставки (constraint=false → не растаскивают компоненты)
    faiss_idx -> g_search [ltail=cluster_schema, style=dotted, label="индекс схемы", constraint=false];
    catalog -> g_prompt   [style=dotted, label="DDL в промпт", constraint=false];
    catalog -> rules      [style=dotted, label="сверка имён", constraint=false];
    explain -> sandbox    [ltail=cluster_p1, style=dotted, dir=both, label="EXPLAIN", constraint=false];
    rag -> vstore         [style=dotted, dir=both, label="поиск знаний", constraint=false];
    cycle -> langfuse     [style=dotted, color="#BDBDBD", label="трейс", constraint=false];
    cycle -> persist      [style=dotted, constraint=false];

    // (Д) петля рефлексии (единственная обратная, constraint=false)
    decide -> refl_model [lhead=cluster_refl, label="не одобрено ✗", color="#E53935", fontcolor="#E53935", constraint=false];
    refl_dedup -> g_prompt [ltail=cluster_refl, lhead=cluster_gen, label="reflection (loop)", style=dashed, color="#8E24AA", fontcolor="#8E24AA", constraint=false];

    // ═══════════ Легенды ═══════════
    subgraph cluster_leg1 {
        label="Природа узла"; labeljust="l"; fontsize=12; style="rounded"; color="#BDBDBD";
        leg1 [label=<<table border="0" cellborder="1" cellspacing="0">
            <tr><td bgcolor="#CE93D8">парсер</td></tr>
            <tr><td bgcolor="#90CAF9">алгоритм</td></tr>
            <tr><td bgcolor="#FFB74D">модель (ML/LLM)</td></tr>
            <tr><td bgcolor="#B0BEC5">данные/хранилище</td></tr></table>>];
    }
    subgraph cluster_leg2 {
        label="Статус (нижняя строка узла)"; labeljust="l"; fontsize=12; style="rounded"; color="#BDBDBD";
        leg2 [label=<<table border="0" cellborder="1" cellspacing="0">
            <tr><td bgcolor="#A5D6A7">🟢 готово (работает в MVP)</td></tr>
            <tr><td bgcolor="#FF8A65">🟧 МОК LLM (mock.py)</td></tr>
            <tr><td bgcolor="#FFCC80">🟧 ЗАГЛУШКА в коде (файл + роль)</td></tr>
            <tr><td bgcolor="#ECEFF1">⬜ не написано (роль-исполнитель)</td></tr></table>>];
    }
}
