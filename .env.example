# Шаблон env для команды (этот файл — в git, без секретов).
# Скопируйте в .env и заполните своими значениями (.env в .gitignore).

# === LLM-бэкенд (приоритет в make_llm) ===
# Вариант A: любой OpenAI-совместимый провайдер (OpenRouter / vLLM serve / российский провайдер)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-...                # вариант 1: в env (для локальной разработки)
# LLM_API_KEY_FILE=/run/secrets/llm_api_key   # вариант 2: docker secrets / k8s
LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
LLM_TIMEOUT=120

# Вариант B (опц.): Colab-туннель — раскомментировать, если не задан LLM_BASE_URL
# COLAB_URL=https://...trycloudflare.com
# COLAB_TOKEN=...

# Вариант C: ничего не задано → автоматически MockLLMClient (для локального демо без сети).

# === Langfuse (опц., трейсинг) ===
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# === Langfuse self-host (docker compose) ===
# Обязательно для запуска contained Langfuse в нашем стеке.
# Генерация:  openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Опц.: первый аккаунт создаётся автоматически (только локально!)
LANGFUSE_INIT_ORG_NAME=sqlsec
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=admin1234
